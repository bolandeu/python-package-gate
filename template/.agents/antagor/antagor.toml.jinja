schema = 1
prefix = "{{ antagor_prefix }}"
name = "{{ antagor_name }}"
{% if include_cli %}checks = ["python3 scripts/check_command_docstrings.py"]{% else %}checks = []{% endif %}
heavy = ["gate check"]

[review]
required_types = ["feature", "bugfix"]  # chore and docs: the short path without review

[publish]
versioning = "semver"
changelog = "CHANGELOG.md"
deploy_command = "sh scripts/deploy.sh"
# The one gate, run on the machine that builds the package, before the tag (the Standard, CI):
# the command of the template tag this package was generated or last updated from.
gate_command = '{{ gate_command }}'
